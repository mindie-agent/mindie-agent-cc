{
  "description": "Native lifecycle prepares one locked runtime; Stop only captures opt-in authorized scopes.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__plugin_mindie-agent_(knowledge|remote|components)__[A-Za-z0-9_.]+$",
        "hooks": [
          {
            "type": "command",
            "command": "uv --native-tls run --offline --no-python-downloads --no-project --python 3.13 python -B \"${CLAUDE_PLUGIN_ROOT}/scripts/plugin_entry.py\" --release-version 0.1.30 hook pretool",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv --native-tls run --offline --no-python-downloads --no-project --python 3.13 python -B \"${CLAUDE_PLUGIN_ROOT}/scripts/plugin_entry.py\" --release-version 0.1.30 hook stop",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv --native-tls run --no-project --python 3.13 python -B \"${CLAUDE_PLUGIN_ROOT}/scripts/plugin_entry.py\" --release-version 0.1.30 hook session-start",
            "timeout": 1440
          }
        ]
      }
    ]
  }
}
