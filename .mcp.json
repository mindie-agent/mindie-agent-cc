{
  "mcpServers": {
    "knowledge": {
      "command": "uv",
      "args": [
        "--native-tls",
        "run",
        "--no-project",
        "--python",
        "3.13",
        "python",
        "-B",
        "${CLAUDE_PLUGIN_ROOT}/scripts/plugin_entry.py",
        "--release-version",
        "0.1.27",
        "mcp",
        "knowledge"
      ],
      "env": {
        "MCP_TOOL_TIMEOUT": "660000"
      },
      "timeout": 660000
    },
    "remote": {
      "command": "uv",
      "args": [
        "--native-tls",
        "run",
        "--no-project",
        "--python",
        "3.13",
        "python",
        "-B",
        "${CLAUDE_PLUGIN_ROOT}/scripts/plugin_entry.py",
        "--release-version",
        "0.1.27",
        "mcp",
        "remote"
      ],
      "env": {
        "REMOTE_DEV_HARNESS_PROFILE": "claude",
        "MCP_TOOL_TIMEOUT": "660000"
      },
      "timeout": 660000
    },
    "components": {
      "command": "uv",
      "args": [
        "--native-tls",
        "run",
        "--no-project",
        "--python",
        "3.13",
        "python",
        "-B",
        "${CLAUDE_PLUGIN_ROOT}/scripts/plugin_entry.py",
        "--release-version",
        "0.1.27",
        "mcp",
        "components"
      ],
      "env": {
        "MCP_TOOL_TIMEOUT": "660000"
      },
      "timeout": 660000
    }
  }
}
